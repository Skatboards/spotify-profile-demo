meta {
  name: Get Playlists
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/playlists
  body: none
  auth: bearer
}

params:query {
  limit: {{limit}}
  offset: {{offset}}
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns playlists", function () {
    const body = res.getBody();

    expect(body.items).to.be.an("array");
    body.items.forEach(function (item) {
      expect(item.type).to.equal("playlist");
      expect(item).to.have.property("itemCount");
    });
  });
}
