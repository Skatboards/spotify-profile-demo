meta {
  name: Get Top Artists
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/top/artists
  body: none
  auth: bearer
}

params:query {
  time_range: {{timeRange}}
  limit: {{limit}}
  offset: {{offset}}
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("returns HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a linked page of artists", function () {
    const body = res.getBody();

    expect(body.items).to.be.an("array");
    expect(body.page).to.be.an("object");
    expect(body._links.self).to.be.an("object");

    body.items.forEach(function (artist) {
      expect(artist).to.be.an("object");
      expect(artist.name).to.be.a("string");
      expect(artist.name).not.to.be.empty;
      expect(artist._links).to.have.property("spotify");
    });
  });
}
